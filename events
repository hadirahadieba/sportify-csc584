<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage Events - Sportify Community</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="app-layout">
    <aside class="sidebar">
      <div class="logo">
        <i class="fa-solid fa-person-running" style="color: #f59e0b; font-size: 24px;"></i>
        <span>Sportify<br>Community</span>
      </div>
      <a href="dashboard.html"><i class="fa-solid fa-house"></i> Dashboard</a>
      <a href="events.html" class="active"><i class="fa-solid fa-calendar-days"></i> Manage Events</a>
      <a href="categories.html"><i class="fa-solid fa-layer-group"></i> Manage Categories</a>
      <a href="registrations.html"><i class="fa-solid fa-clipboard-list"></i> Manage Registrations</a>
      <a href="logout.html"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
    </aside>

    <main class="main-content">
      <div class="page-header">
        <h2>Manage Sports Events</h2>
        <a href="add-event.html" class="btn-small"><i class="fa-solid fa-plus"></i> Add Event</a>
      </div>

      <div class="card-table">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Event Name</th>
              <th>Category</th>
              <th>Date</th>
              <th>Venue</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>1</td>
              <td><a href="event-details.html" style="color: #2d2a4a; font-weight: 600; text-decoration: none;">Community Football</a></td>
              <td>Football</td>
              <td>16 Nov 2026</td>
              <td>Sports Hall</td>
              <td><span class="badge badge-open">Open</span></td>
              <td class="action-icons">
                <a href="event-details.html" class="icon-edit" title="View / Register"><i class="fa-solid fa-eye"></i></a>
                <a href="edit-event.html" class="icon-edit" title="Edit"><i class="fa-solid fa-pen"></i></a>
                <a href="#" class="icon-delete" title="Delete" onclick="return confirm('Delete Community Football?');"><i class="fa-solid fa-trash"></i></a>
              </td>
            </tr>
            <tr>
              <td>2</td>
              <td><a href="event-details.html" style="color: #2d2a4a; font-weight: 600; text-decoration: none;">Badminton Tournament</a></td>
              <td>Badminton</td>
              <td>15 Nov 2026</td>
              <td>Arena A</td>
              <td><span class="badge badge-open">Open</span></td>
              <td class="action-icons">
                <a href="event-details.html" class="icon-edit" title="View / Register"><i class="fa-solid fa-eye"></i></a>
                <a href="edit-event.html" class="icon-edit" title="Edit"><i class="fa-solid fa-pen"></i></a>
                <a href="#" class="icon-delete" title="Delete" onclick="return confirm('Delete Badminton Tournament?');"><i class="fa-solid fa-trash"></i></a>
              </td>
            </tr>
            <tr>
              <td>3</td>
              <td><a href="event-details.html" style="color: #2d2a4a; font-weight: 600; text-decoration: none;">Volleyball Cup</a></td>
              <td>Volleyball</td>
              <td>22 Nov 2026</td>
              <td>Indoor Court</td>
              <td><span class="badge badge-closed">Closed</span></td>
              <td class="action-icons">
                <a href="event-details.html" class="icon-edit" title="View / Register"><i class="fa-solid fa-eye"></i></a>
                <a href="edit-event.html" class="icon-edit" title="Edit"><i class="fa-solid fa-pen"></i></a>
                <a href="#" class="icon-delete" title="Delete" onclick="return confirm('Delete Volleyball Cup?');"><i class="fa-solid fa-trash"></i></a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>
